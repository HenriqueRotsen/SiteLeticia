NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Em produção (Vercel): https://leticiavrcunha.com.br
# Isso evita links de recuperação de senha apontando para localhost.

# Modo demo local (sem Supabase/login): cp .env.demo .env.local && npm run dev:demo
DEMO_MODE=false
NEXT_PUBLIC_DEMO_MODE=false

# Segurança
CPF_HASH_SECRET=generate-a-long-random-secret
TOKEN_ENCRYPTION_SECRET=generate-a-long-random-secret-for-oauth-tokens

# Google Calendar (opcional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/calendar/callback
# Em produção: https://leticiavrcunha.com.br/api/auth/google/calendar/callback

# IA para extracao de dietas/exames PDF
# Preferência automática: Gemini (créditos gratuitos) se GEMINI_API_KEY existir; senão OpenAI.
# Force com AI_PROVIDER=gemini|openai|auto
AI_PROVIDER=auto
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash
OPENAI_API_KEY=
# OPENAI_DIET_MODEL=gpt-4o-mini

# Alimentos — legado (busca TACO/TBCA/USDA/FatSecret).
# A montagem de dieta agora é via PDF FatSecret; estas chaves são opcionais.
USDA_API_KEY=

# FatSecret API (legado / opcional — a dieta oficial entra por PDF)
FATSECRET_CLIENT_ID=
FATSECRET_CLIENT_SECRET=
FATSECRET_SCOPE=basic

# Storage buckets (criar no Supabase)
SUPABASE_STORAGE_BUCKET_PHOTOS=progress-photos
SUPABASE_STORAGE_BUCKET_LABS=lab-reports
SUPABASE_STORAGE_BUCKET_DIETS=diet-plans
SUPABASE_STORAGE_BUCKET_PAYMENTS=payment-docs
SUPABASE_STORAGE_BUCKET_CLINICAL=clinical-records

# Keep-alive do Supabase (Vercel Cron + GitHub Actions)
# 1) Defina o mesmo valor em Vercel → Environment Variables
# 2) No GitHub → Settings → Secrets and variables → Actions:
#    CRON_SECRET=<mesmo valor da Vercel>
#    KEEP_ALIVE_URL=https://leticiavrcunha.com.br/api/keep-alive
CRON_SECRET=generate-a-long-random-secret-for-vercel-cron

# Legado (pode remover após migrar admin)
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# reCAPTCHA legado da fila (opcional)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Contato público (landing / página de contato)
NEXT_PUBLIC_CONTACT_EMAIL=leticiavrcunha@gmail.com
NEXT_PUBLIC_CONTACT_WHATSAPP=5531987450173
NEXT_PUBLIC_CONTACT_INSTAGRAM=leticiavrcunha

# E-mail da nutricionista para promover role nutritionist no primeiro deploy
NUTRITIONIST_EMAIL=leticiavrcunha@gmail.com

# Resend (redefinição de senha + código 2FA por e-mail)
RESEND_API_KEY=
# Após verificar o domínio no Resend, use algo como:
# RESEND_FROM_EMAIL="Letícia Cunha <noreply@leticiavrcunha.com.br>"
RESEND_FROM_EMAIL="Letícia Cunha <onboarding@resend.dev>"
# AUTH_EMAIL_MFA=false desliga o 2FA por e-mail (não recomendado em produção)
AUTH_EMAIL_MFA=true
OTP_HASH_SECRET=generate-a-long-random-secret-for-otp
