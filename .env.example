NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Em produção, use o domínio público (ex.: https://app.seudominio.com.br).
# Isso evita links de recuperação de senha apontando para localhost.

# Modo demo local (sem Supabase/login): cp .env.demo .env.local && npm run dev:demo
DEMO_MODE=false
NEXT_PUBLIC_DEMO_MODE=false

# Segurança
CPF_HASH_SECRET=generate-a-long-random-secret
TOKEN_ENCRYPTION_SECRET=generate-a-long-random-secret-for-oauth-tokens

# Google Calendar (opcional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/calendar/callback

# Extracao de exames (opcional — fallback regex funciona sem IA)
OPENAI_API_KEY=

# Alimentos — USDA FoodData Central (busca internacional)
# Chave gratuita em https://api.data.gov/signup/
USDA_API_KEY=

# Alimentos — FatSecret (busca na montagem de dieta)
# Crie as chaves em https://platform.fatsecret.com e libere o IP do servidor (Vercel) em Manage API Keys.
FATSECRET_CLIENT_ID=
FATSECRET_CLIENT_SECRET=
FATSECRET_SCOPE=basic
# Localização BR/pt é recurso premium do FatSecret (contas selecionadas).
# Sem isso, a API usa região US e idioma en por padrão — use a tabela TACO para alimentos brasileiros.
# Quando o FatSecret liberar localization na sua conta:
# FATSECRET_LOCALIZATION=true
# FATSECRET_REGION=BR
# FATSECRET_LANGUAGE=pt
# FATSECRET_SCOPE=basic localization

# Storage buckets (criar no Supabase)
SUPABASE_STORAGE_BUCKET_PHOTOS=progress-photos
SUPABASE_STORAGE_BUCKET_LABS=lab-reports

# Compressão de PDFs (opcional — usa `gs` do sistema se disponível; na Vercel só pdf-lib)
# GHOSTSCRIPT_BIN=gs

# Cron keep-alive
CRON_SECRET=generate-a-long-random-secret-for-vercel-cron

# Legado (pode remover após migrar admin)
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# reCAPTCHA legado da fila (opcional)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Contato público (landing / página de contato)
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_WHATSAPP=
NEXT_PUBLIC_CONTACT_INSTAGRAM=

# E-mail da nutricionista para promover role nutritionist no primeiro deploy
NUTRITIONIST_EMAIL=leticia@example.com
