NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
ADMIN_USERNAME=leticia
ADMIN_PASSWORD=change-this-password
ADMIN_SESSION_SECRET=generate-a-long-random-secret
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your-google-recaptcha-v3-site-key
RECAPTCHA_SECRET_KEY=your-google-recaptcha-v3-secret-key

# Keep-alive do Supabase (Vercel Cron + GitHub Actions)
# 1) Defina o mesmo valor em Vercel → Environment Variables
# 2) No GitHub → Settings → Secrets and variables → Actions:
#    CRON_SECRET=<mesmo valor da Vercel>
#    KEEP_ALIVE_URL=https://seu-dominio-em-producao.com/api/keep-alive
CRON_SECRET=generate-a-long-random-secret-for-vercel-cron
